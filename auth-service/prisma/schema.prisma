generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  email        String   @unique
  password     String
  role         String   @default("user")
  refreshToken String?
  preferences  Json?    @default("{}")
  created_at    DateTime @default(now())
}
